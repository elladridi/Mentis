<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #4CAF50; -fx-border-width: 0 2 0 0; -fx-pref-width: 250;">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="30.0" /></padding>
            <children>
                <Text style="-fx-fill: #4CAF50; -fx-font-size: 26; -fx-font-weight: bold;" text="Mentis" />
                <Separator opacity="0.5" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E8F5E9; -fx-text-fill: #4CAF50; -fx-alignment: CENTER_LEFT; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 10;" text="🏠 Dashboard" />
                <Button maxWidth="Infinity" onAction="#goToMood" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="📊 Mood tracking" />
                <Button maxWidth="Infinity" onAction="#goToGoals" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="🎯 Goal Tracking" />
                <Separator opacity="0.3" />
                <Text style="-fx-fill: #7f8c8d; -fx-font-size: 12; -fx-font-weight: bold;" text="MENTIS TOOLS" />
                <Button maxWidth="Infinity" onAction="#handleAIScanner" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="🤖 AI Scanner" />
                <Button maxWidth="Infinity" onAction="#handleMoodCharts" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="📈 Mood Charts" />
                <Button maxWidth="Infinity" onAction="#handleReflect" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="🧘 Reflectyy" />
                <Button maxWidth="Infinity" onAction="#handleQuotas" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT;" text="💡 Daily Quotas" />
                <Region VBox.vgrow="ALWAYS" />
                <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: #FFEBEE; -fx-text-fill: #c0392b; -fx-background-radius: 10;" text="🚪 Déconnexion" />
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="mainContainer">
            <children>
                <HBox alignment="CENTER" spacing="50.0">
                    <children>
                        <VBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Label text="Répartition Mentis" style="-fx-font-size: 26; -fx-text-fill: #2E7D32; -fx-font-weight: bold;" />
                                <StackPane>
                                    <PieChart fx:id="userDistributionChart" prefHeight="400.0" prefWidth="450.0" />
                                    <Circle radius="70.0" fill="WHITE" />
                                </StackPane>
                            </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="15.0" prefWidth="350.0">
                            <children>
                                <Label text="Avis de la communauté" style="-fx-font-size: 20; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" />
                                <ScrollPane fx:id="reviewsScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" prefHeight="400.0"
                                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                    <content>
                                        <VBox fx:id="reviewsBox" spacing="20.0" style="-fx-background-color: transparent;">
                                            <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </StackPane>
    </center>
</BorderPane>