<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mentalhealth.app.controllers.MainController"
            styleClass="main-root"
            stylesheets="@../styles/mentis.css">

    <!-- ============= HEADER ============= -->
    <top>
        <VBox styleClass="header-container">
            <HBox styleClass="header" alignment="CENTER_LEFT" spacing="24">
                <padding>
                    <Insets top="16" right="32" bottom="16" left="32"/>
                </padding>

                <!-- Logo Section (Image Only) -->
                <HBox alignment="CENTER_LEFT" styleClass="logo-section">
                    <ImageView fitHeight="60" preserveRatio="true" pickOnBounds="true"
                               styleClass="logo-image">
                        <image>
                            <Image url="@../images/logo.png"/>
                        </image>
                    </ImageView>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search Bar -->
                <HBox styleClass="search-container" alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField"
                               promptText="Search the platform..."
                               styleClass="header-search"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Right Side Actions -->
                <HBox alignment="CENTER" spacing="20">
                    <!-- Notifications -->
                    <StackPane styleClass="icon-btn-wrapper">
                        <Button styleClass="icon-btn" text="🔔"/>
                        <Circle radius="4" styleClass="notification-dot"
                                translateX="8" translateY="-8"/>
                    </StackPane>

                    <!-- Help -->
                    <Button styleClass="icon-btn" text="❓"/>

                    <!-- Divider -->
                    <Separator orientation="VERTICAL" styleClass="header-divider"/>

                    <!-- User Profile -->
                    <HBox alignment="CENTER" spacing="12" styleClass="user-profile">
                        <StackPane styleClass="avatar-wrapper">
                            <Circle radius="18" styleClass="avatar-circle"/>
                            <Label text="A" styleClass="avatar-letter"/>
                        </StackPane>
                        <VBox spacing="0" alignment="CENTER_LEFT">
                            <Label text="Admin User" styleClass="user-name"/>
                            <Label text="Administrator" styleClass="user-role"/>
                        </VBox>
                        <Label text="▼" styleClass="dropdown-arrow"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Header Bottom Border -->
            <HBox styleClass="header-border"/>
        </VBox>
    </top>

    <!-- ============= SIDEBAR ============= -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="280" spacing="0">

            <!-- Quick Stats Card -->
            <VBox styleClass="sidebar-stats-card" spacing="8">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <Label text="Today's Overview" styleClass="stats-card-title"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox styleClass="mini-stat" alignment="CENTER">
                        <Label text="12" styleClass="mini-stat-value"/>
                        <Label text="Events" styleClass="mini-stat-label"/>
                    </VBox>
                    <Separator orientation="VERTICAL" styleClass="stat-divider"/>
                    <VBox styleClass="mini-stat" alignment="CENTER">
                        <Label text="48" styleClass="mini-stat-value"/>
                        <Label text="Bookings" styleClass="mini-stat-label"/>
                    </VBox>
                    <Separator orientation="VERTICAL" styleClass="stat-divider"/>
                    <VBox styleClass="mini-stat" alignment="CENTER">
                        <Label text="5" styleClass="mini-stat-value"/>
                        <Label text="Pending" styleClass="mini-stat-label"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Navigation -->
            <VBox spacing="4" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="24" right="16" bottom="20" left="16"/>
                </padding>

                <!-- Main Navigation Section -->
                <Label text="MAIN MENU" styleClass="sidebar-section-label"/>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="📊" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Dashboard" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="📅" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Bookings" styleClass="nav-text"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="48" styleClass="nav-badge"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="📝" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Assessments" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="😊" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Mood Tracker" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="📚" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Content Library" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Management Section -->
                <Label text="MANAGEMENT" styleClass="sidebar-section-label">
                    <padding>
                        <Insets top="24" right="0" bottom="8" left="0"/>
                    </padding>
                </Label>

                <Button fx:id="btnEvents"
                        onAction="#handleEventsClick"
                        styleClass="sidebar-btn, sidebar-btn-active"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper-active">
                                <Label text="📌" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Events" styleClass="nav-text-active"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="NEW" styleClass="nav-badge-new"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnReservations"
                        onAction="#handleReservationsClick"
                        styleClass="sidebar-btn"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="🎟" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Reservations" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="👥" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Users" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="sidebar-separator"/>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="⚙️" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Settings" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="sidebar-btn" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane styleClass="nav-icon-wrapper">
                                <Label text="❓" styleClass="nav-icon"/>
                            </StackPane>
                            <Label text="Help &amp; Support" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <!-- Sidebar Footer -->
            <VBox styleClass="sidebar-footer" alignment="CENTER" spacing="8">
                <padding>
                    <Insets top="16" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Upgrade Card -->
                <VBox styleClass="upgrade-card" spacing="8" alignment="CENTER">
                    <Label text="🌟" styleClass="upgrade-icon"/>
                    <Label text="Upgrade to Pro" styleClass="upgrade-title"/>
                    <Label text="Unlock all features" styleClass="upgrade-subtitle"/>
                    <Button text="Learn More" styleClass="btn-upgrade"/>
                </VBox>

                <HBox alignment="CENTER" spacing="8">
                    <Label text="Mentis v1.0" styleClass="sidebar-footer-text"/>
                    <Label text="•" styleClass="footer-dot"/>
                    <Label text="Events Module" styleClass="sidebar-footer-text"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ============= MAIN CONTENT ============= -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>