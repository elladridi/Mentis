<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mentalhealth.app.controllers.RegistrationFormController"
            fitToWidth="true"
            styleClass="form-scroll-pane"
            stylesheets="@../styles/mentis.css">

    <VBox styleClass="form-container"
          spacing="24"
          alignment="TOP_CENTER">

        <padding>
            <Insets top="40" right="60" bottom="40" left="60"/>
        </padding>

        <!-- Form Header Card -->
        <VBox styleClass="form-header-card" spacing="8" alignment="CENTER">
            <Label text="🎟️" styleClass="form-emoji"/>
            <Label fx:id="formTitle"
                   text="Event Registration"
                   styleClass="form-title"/>
            <Label text="Complete the form below to register for this event"
                   styleClass="form-subtitle"/>
        </VBox>

        <!-- Event Info Card -->
        <VBox fx:id="eventInfoCard" styleClass="event-info-card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="event-icon-wrapper">
                    <Circle radius="20" styleClass="event-icon-circle"/>
                    <Label text="📅" styleClass="event-icon"/>
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="eventLabel"
                           text="Mental Health Workshop 2024"
                           styleClass="event-name-text"/>
                    <Label fx:id="eventDateLabel"
                           text="March 15, 2024 • 10:00 AM"
                           styleClass="event-date-text"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="availability-badge">
                    <Label fx:id="availLabel"
                           text="24 spots left"
                           styleClass="availability-text"/>
                </VBox>
            </HBox>

            <!-- Price Info Row -->
            <HBox styleClass="price-info-row" alignment="CENTER_LEFT" spacing="16">
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="💰" styleClass="price-icon"/>
                    <Label fx:id="basePriceLabel"
                           text="Base Price: $50.00"
                           styleClass="price-info-text"/>
                </HBox>
                <Separator orientation="VERTICAL" styleClass="price-separator"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="📍" styleClass="price-icon"/>
                    <Label fx:id="locationLabel"
                           text="Online Event"
                           styleClass="price-info-text"/>
                </HBox>
            </HBox>
        </VBox>

        <!-- Main Form Card -->
        <VBox styleClass="form-card" spacing="24">

            <!-- Section: Personal Information -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="👤" styleClass="section-emoji"/>
                    <Label text="Personal Information" styleClass="form-section-title"/>
                </HBox>

                <!-- Full Name Field -->
                <VBox spacing="6" styleClass="field-group">
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Full Name" styleClass="field-label"/>
                        <Label text="*" styleClass="required-marker"/>
                    </HBox>
                    <TextField fx:id="nameField"
                               promptText="Enter your full name"
                               styleClass="mint-text-field"/>
                </VBox>

                <!-- Email & Phone Row -->
                <HBox spacing="20">
                    <!-- Email Field -->
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Email Address" styleClass="field-label"/>
                            <Label text="*" styleClass="required-marker"/>
                        </HBox>
                        <HBox styleClass="input-with-icon">
                            <Label text="📧" styleClass="input-icon"/>
                            <TextField fx:id="emailField"
                                       promptText="your@email.com"
                                       styleClass="mint-text-field-with-icon"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="We'll send confirmation to this email"
                               styleClass="field-hint"/>
                    </VBox>

                    <!-- Phone Field -->
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Phone Number" styleClass="field-label"/>
                        <HBox styleClass="input-with-icon">
                            <Label text="📱" styleClass="input-icon"/>
                            <TextField fx:id="phoneField"
                                       promptText="+1 (555) 123-4567"
                                       styleClass="mint-text-field-with-icon"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Label text="Optional - for event reminders"
                               styleClass="field-hint"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Divider -->
            <Separator styleClass="form-divider"/>

            <!-- Section: Ticket Selection -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🎫" styleClass="section-emoji"/>
                    <Label text="Ticket Selection" styleClass="form-section-title"/>
                </HBox>

                <HBox spacing="20">
                    <!-- Ticket Type -->
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Ticket Type" styleClass="field-label"/>
                        <ComboBox fx:id="ticketTypeBox"
                                  promptText="Select ticket type"
                                  styleClass="mint-combo-box"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <!-- Number of Tickets -->
                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Quantity" styleClass="field-label"/>
                        <HBox styleClass="quantity-selector" alignment="CENTER" spacing="0">
                            <Button fx:id="decreaseBtn"
                                    text="−"
                                    onAction="#handleDecrease"
                                    styleClass="quantity-btn-left"/>
                            <TextField fx:id="ticketCountField"
                                       text="1"
                                       styleClass="quantity-field"
                                       alignment="CENTER"
                                       prefWidth="60"/>
                            <Button fx:id="increaseBtn"
                                    text="+"
                                    onAction="#handleIncrease"
                                    styleClass="quantity-btn-right"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Ticket Option Cards -->
                <HBox fx:id="ticketCardsRow" spacing="12" styleClass="ticket-cards-row">
                    <!-- Standard Ticket Card -->
                    <VBox fx:id="standardCard"
                          styleClass="ticket-option-card"
                          onMouseClicked="#selectStandard"
                          HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🎟️" styleClass="ticket-card-icon"/>
                            <Label text="Standard" styleClass="ticket-card-title"/>
                        </HBox>
                        <Label text="$50.00" styleClass="ticket-card-price"/>
                        <Label text="General admission" styleClass="ticket-card-desc"/>
                    </VBox>

                    <!-- VIP Ticket Card -->
                    <VBox fx:id="vipCard"
                          styleClass="ticket-option-card"
                          onMouseClicked="#selectVIP"
                          HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⭐" styleClass="ticket-card-icon"/>
                            <Label text="VIP Pass" styleClass="ticket-card-title"/>
                        </HBox>
                        <Label text="$120.00" styleClass="ticket-card-price"/>
                        <Label text="Premium seating + extras" styleClass="ticket-card-desc"/>
                    </VBox>

                    <!-- Early Bird Card -->
                    <VBox fx:id="earlyBirdCard"
                          styleClass="ticket-option-card"
                          onMouseClicked="#selectEarlyBird"
                          HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🐦" styleClass="ticket-card-icon"/>
                            <Label text="Early Bird" styleClass="ticket-card-title"/>
                        </HBox>
                        <Label text="$35.00" styleClass="ticket-card-price"/>
                        <Label text="Limited time offer" styleClass="ticket-card-desc"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Divider -->
            <Separator styleClass="form-divider"/>

            <!-- Section: Payment Details -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="💳" styleClass="section-emoji"/>
                    <Label text="Payment Details" styleClass="form-section-title"/>
                </HBox>

                <HBox spacing="20">
                    <!-- Payment Method -->
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Payment Method" styleClass="field-label"/>
                        <ComboBox fx:id="paymentBox"
                                  promptText="Select payment method"
                                  styleClass="mint-combo-box"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <!-- Status -->
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Status" styleClass="field-label"/>
                        <ComboBox fx:id="statusBox"
                                  promptText="Select status"
                                  styleClass="mint-combo-box"
                                  maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <!-- Total Price Display -->
                <VBox styleClass="total-price-card" spacing="8" alignment="CENTER">
                    <Label text="Total Amount" styleClass="total-label"/>
                    <Label fx:id="totalPriceLabel"
                           text="$50.00"
                           styleClass="total-price-value"/>
                    <Label fx:id="priceBreakdown"
                           text="1 × Standard Ticket @ $50.00"
                           styleClass="price-breakdown"/>
                </VBox>
            </VBox>

            <!-- Divider -->
            <Separator styleClass="form-divider"/>

            <!-- Section: Additional Information -->
            <VBox spacing="16">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📝" styleClass="section-emoji"/>
                    <Label text="Additional Information" styleClass="form-section-title"/>
                </HBox>

                <!-- Special Requests -->
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Special Requests or Notes" styleClass="field-label"/>
                    <TextArea fx:id="specialReqField"
                              promptText="Let us know if you have any special requirements..."
                              styleClass="mint-text-area"
                              wrapText="true"
                              prefRowCount="4"/>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Optional" styleClass="field-hint"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="charCountLabel"
                               text="0 / 500"
                               styleClass="char-count"/>
                    </HBox>
                </VBox>
            </VBox>

        </VBox>

        <!-- Error Message Card -->
        <HBox fx:id="errorContainer"
              styleClass="error-card"
              alignment="CENTER_LEFT"
              spacing="12"
              visible="false"
              managed="false">
            <Label text="⚠️" styleClass="error-icon"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Registration Error" styleClass="error-title"/>
                <Label fx:id="errorLabel"
                       text=""
                       styleClass="error-text"
                       wrapText="true"/>
            </VBox>
            <Button text="✕"
                    onAction="#hideError"
                    styleClass="error-close-btn"/>
        </HBox>

        <!-- Success Message Card -->
        <HBox fx:id="successContainer"
              styleClass="success-card"
              alignment="CENTER_LEFT"
              spacing="12"
              visible="false"
              managed="false">
            <Label text="✓" styleClass="success-icon"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Registration Successful!" styleClass="success-title"/>
                <Label fx:id="successLabel"
                       text="Confirmation email sent"
                       styleClass="success-text"/>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="16" styleClass="form-actions">
            <Button fx:id="cancelBtn"
                    text="← Cancel"
                    onAction="#handleCancel"
                    styleClass="btn-secondary-outline"
                    prefWidth="150"/>
            <Button fx:id="saveBtn"
                    text="Complete Registration ✓"
                    onAction="#handleSave"
                    styleClass="btn-primary-mint"
                    prefWidth="220"/>
        </HBox>

        <!-- Terms & Footer -->
        <VBox alignment="CENTER" spacing="8" styleClass="form-footer">
            <HBox alignment="CENTER" spacing="8">
                <CheckBox fx:id="termsCheckbox" styleClass="mint-checkbox"/>
                <Label text="I agree to the " styleClass="terms-text"/>
                <Hyperlink text="Terms &amp; Conditions" styleClass="terms-link"/>
                <Label text=" and " styleClass="terms-text"/>
                <Hyperlink text="Privacy Policy" styleClass="terms-link"/>
            </HBox>
            <Label text="* Required fields" styleClass="footer-hint"/>
        </VBox>

    </VBox>
</ScrollPane>