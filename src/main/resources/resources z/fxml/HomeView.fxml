<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">

    <left>
        <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #4CAF50; -fx-border-width: 0 2 0 0; -fx-pref-width: 250;">
            <padding><Insets bottom="20.0" left="15.0" right="15.0" top="30.0" /></padding>
            <children>
                <Text style="-fx-fill: #4CAF50; -fx-font-size: 26; -fx-font-weight: bold;" text="Mentis" />
                <Separator opacity="0.5" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E8F5E9; -fx-text-fill: #4CAF50; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold; -fx-background-radius: 10;" text="🏠 Dashboard" />
                <Button maxWidth="Infinity" onAction="#goToMood" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="📊 Mood tracking" />
                <Button maxWidth="Infinity" onAction="#goToGoals" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="🎯 Goal Tracking" />
                <Region VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="mainContainer">
            <children>
                <HBox alignment="CENTER" spacing="50.0">
                    <children>
                        <VBox alignment="CENTER" spacing="20.0">
                            <Label text="Répartition Mentis" style="-fx-font-size: 26; -fx-text-fill: #2E7D32; -fx-font-weight: bold;" />
                            <PieChart fx:id="userDistributionChart" prefHeight="400.0" prefWidth="450.0" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="15.0" prefWidth="350.0">
                            <Label text="Avis de la communauté" style="-fx-font-size: 20; -fx-text-fill: #2c3e50; -fx-font-weight: bold;" />
                            <ScrollPane fx:id="reviewsScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" prefHeight="450.0" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <content>
                                    <VBox fx:id="reviewsBox" spacing="15.0" style="-fx-background-color: transparent;">
                                        <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </VBox>
                    </children>
                </HBox>

                <AnchorPane pickOnBounds="false">
                    <children>
                        <VBox fx:id="feedbackForm" visible="false" spacing="12" prefWidth="300.0" AnchorPane.bottomAnchor="100.0" AnchorPane.rightAnchor="30.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5); -fx-border-color: #4CAF50; -fx-border-width: 1.5; -fx-border-radius: 20;">
                            <children>
                                <Label text="Votre avis nous importe ✨" style="-fx-font-weight: bold; -fx-text-fill: #2E7D32; -fx-font-size: 14;" />
                                <TextField fx:id="inputUser" promptText="Votre nom" />
                                <TextArea fx:id="inputComment" prefHeight="100.0" promptText="Message..." wrapText="true" />
                                <Button maxWidth="Infinity" onAction="#handleAddFeedback" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="PUBLIER" />
                            </children>
                        </VBox>
                        <Button onAction="#toggleFeedbackForm" prefHeight="65.0" prefWidth="65.0" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4); -fx-cursor: hand;" text="💬" textFill="WHITE">
                            <font><Font size="28.0" /></font>
                        </Button>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
