<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.GoalController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <children>
        <Label style="-fx-font-size: 40px; -fx-font-weight: bold;" text="GOALS" />
        <TableView fx:id="tableGoals" onMouseClicked="#loadSelectedGoal" prefHeight="129.0" prefWidth="500.0">
            <columns>
                <TableColumn fx:id="colDescription" prefWidth="120.0" text="DESCRIPTION" />
                <TableColumn fx:id="colStatus" prefWidth="200.0" text="STATUS" />
                <TableColumn fx:id="colProgress" prefWidth="150.0" text="PROGRESS" />
                <TableColumn fx:id="colDeadline" prefWidth="75.0" text="DEADLINE" />
            </columns>
        </TableView>
        <TextField fx:id="inputGoal" maxWidth="300" promptText="Description" />
        <TextField fx:id="inputDescription" maxWidth="300" promptText="Description pour l'IA (optionnel)" />
        <DatePicker fx:id="inputDeadline" promptText="Choisir une date" />
        <ComboBox fx:id="comboStatus" prefWidth="150.0" promptText="Statut" />
        <Slider fx:id="inputProgress" prefHeight="14.0" prefWidth="306.0" showTickLabels="true" />
        <HBox alignment="CENTER" spacing="10.0">
            <Button onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="SAVE" />
            <Button onAction="#handleUpdate" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="UPDATE" />
            <Button onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="DELETE" />
            <Button onAction="#handleAIStrategy" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" text="🤖 IA Conseils" />
        </HBox>
        <Button onAction="#backToHome" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="⬅ BACK TO MENU" />
        <Button onAction="#openChatWindow" style="-fx-background-color: #0084FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="💬 Ouvrir le Chat" />
    </children>
</VBox>
